{
  "name": "paths-we-choose",
  "private": true,
  "version": "0.1.0",
  "description": "The Paths We Choose - A tabletop-inspired dungeon-crawl and path-building card game",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run docs:check && npm run i18n:check && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "seo:assets": "node scripts/generateSeoShare.cjs",
    "docs:sync": "node scripts/sync-doc-catalogs.cjs",
    "docs:check": "node scripts/sync-doc-catalogs.cjs --check",
    "i18n:check": "node scripts/check-locales.cjs"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
