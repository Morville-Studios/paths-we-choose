# The document shell and fixed-name public media revalidate so releases appear
# without asking players to clear browser caches.
/*
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/version.json
  Cache-Control: no-cache, no-store, must-revalidate

# Vite fingerprints these filenames; they are safe to cache permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/seo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
